{
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{"type": "host", "value": "nexoraos.digital"}],
      "destination": "https://www.nexoraos.digital/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
