# Supabase (ALL THREE required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Model (OpenAI-compatible server)
MODEL_NAME=DeepSeek-V4.1-Flash
EMBEDDING_MODEL=
MODEL_PATH=/workspace/DeepSeek-V4.1-Flash-INT4
LOCAL_MODEL_URL=http://localhost:8000/v1

# Webhook verification (required when the matching channel is enabled)
WHATSAPP_APP_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Scheduler
SCHEDULER_INTERVAL_MINUTES=60

# Optional external services
BROWSER_CONTROL_URL=http://localhost:3200
WEB_SEARCH_URL=http://localhost:3100
COMPOSIO_API_KEY=

# Required for social account token encryption. Generate a random 32-byte key; use 64 hex chars or base64. Keep stable across restarts and backups.
CREDENTIALS_ENCRYPTION_KEY=

# Optional channels
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=

FLUX_WORKSPACE=/workspace/flux
PORT=3000
